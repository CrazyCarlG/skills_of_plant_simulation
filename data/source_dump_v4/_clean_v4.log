2026-08-31 21:03:20: -- called by: startSearch (search button)
param t : table

t.openDialog
HTML.cont := "<HTML>"
HTML.cont := to_str(HTML.cont, "<html lang=\"en\"><head>")
HTML.cont := to_str(HTML.cont, "<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">")
HTML.cont := to_str(HTML.cont, "<meta charset=\"utf-8\">")
--HTML.cont := to_str(HTML.cont, "<base target=\"_blank\">") -- not needed in 13.2 and newer
HTML.cont := to_str(HTML.cont, "<title>.UserInterface.HtmlReport</title>")

HTML.cont := to_str(HTML.cont, "<style id=\"defaultCSS\" type=\"text/css\">")
HTML.cont := to_str(HTML.cont, "h1 {")
HTML.cont := to_str(HTML.cont, "font-family:         Calibri, Tahoma, Arial, 'Arial Unicode', 'Segoe UI Symbol', sans-serif;")
HTML.cont := to_str(HTML.cont, "font-size:           21px;}")

HTML.cont := to_str(HTML.cont, "h3 {")
HTML.cont := to_str(HTML.cont, "font-family:         Calibri, Tahoma, Arial, 'Arial Unicode', 'Segoe UI Symbol', sans-serif;")
HTML.cont := to_str(HTML.cont, "font-size:           17px;}")

HTML.cont := to_str(HTML.cont, "body {")
HTML.cont := to_str(HTML.cont, "font-family:         Calibri, Tahoma, Arial, 'Arial Unicode', 'Segoe UI Symbol', sans-serif;")
HTML.cont := to_str(HTML.cont, "font-size:           15px;}")

HTML.cont := to_str(HTML.cont, "</style>")
HTML.cont := to_str(HTML.cont, "</head>")

HTML.cont :=to_str(HTML.cont, "<BODY>")

var str : string:= ~.Localization.getText(3)              -- results of searching for
HTML.cont :=to_str(HTML.cont, "<h1>", str, " ", searchStr, "</h1>")

var numberOfCharacter : integer := maxDescription
var text : string
for var i := 1 to t.YDim loop
	if UserInterfaceLanguage=0 then
		text := t[3,i]
		var header := t[1,i]
	else
		text := t[4,i]
		header := t[2,i]
	end
				
	str :=strCopy(text, numberOfCharacter, strLen(text))
	var p := strLpos(" ", str)
	if p>0 then
		str := to_str(strCopy(text, 1, numberOfCharacter+p-1), " ...")
	else
		str := text -- not truncated
	end
				
	var frame := t[7,i]
	var objFile :=     t[6,i]
				
	HTML.cont := to_str(HTML.cont, "<h3>",MarkText(header,searchStr), "</h3>")
	HTML.cont := to_str(HTML.cont, MarkText(str,searchStr))
	HTML.cont := to_str(HTML.cont, "<p>")
	-- HTML.cont := to_str(HTML.cont, "<A NAME=2 HREF=\"/SC_CallMethod:.Models.Frame1.Dispatcher|BEEP\" target=\"_top\">Tell Plant Simulation to start a simulation.</A>")
	--  HTML.cont := to_str(HTML.cont, "<A HREF=\"/SC_CallMethod:.Models.Frame1.Dispatcher|BEEP\" target=\"_top\">Tell Plant Simulation to start a simulation.</A>")
	HTML.cont := to_str(HTML.cont, "<a href=\"callMethod:.Models.Internal.Admin.Dispatcher|",frame,"+",objFile,"+",t[5,i],"\">",~.Localization.getText(5),"</a>")
	HTML.cont := to_str(HTML.cont, "</p>")

next

str := ~.Localization.getText(4)              -- search results       WindowTitle, x-position on screen, y-position, width, height
var HTML:string := Dispatcher("$")
openHTMLWindow(HTML,~.Localization.getText(14), 50,10,750,500) -- "Search Results"
