2026-08-31 21:03:19: ###P:.Models.internal.Admin.GeneralTable2ExampleTab###
2026-08-31 21:03:19: -- Copying GeneralTable to ExampleTab, which is used for searching
-- SelDlg.GeneralTable is used for the dialog
var GeneralTableAttr:table := ~.SelDlg.GeneralTable
var TargetTab:object := ExampleTab
TargetTab.delete
var currRow:integer
var TitleENU, TitleDEU, DescriptionENU, DescriptionDEU:string -- set byref in method_partitionDescription

for var CategoryNo := 1 to GeneralTableAttr.yDim
	var CatTab:table := GeneralTableAttr[1,CategoryNo]
	
	for var objNo := 1 to CatTab.yDim  -- object/Folder
		var CategoryInfo:string := to_str(CatTab[3,objNo]," ",CatTab[4,objNo]," ") -- "Topic" German, English
		var with3D:boolean := CatTab[7,objNo]
		var objName:string := CatTab[2,objNo] -- Name of the folder/object
		var modTab:table   := CatTab[1,objNo]
		for var modNo := 1 to modTab.ydim --
			var frameName:string := modTab[2,modNo]
			var descTab:table    := modTab[1,modNo]
			--if objName="CostAnalyzer" then debug end
			partitionDescription(descTab[1,1],descTab[2,1], TitleENU, TitleDEU, DescriptionENU, DescriptionDEU)
			currRow += 1 -- New row of ExampleTab
			TargetTab.writeRow(1, currRow, to_str(objName,".obj"), to_str(".Models.",objName,".",frameName), with3D, Void,TitleENU, TitleDEU, DescriptionENU, DescriptionDEU, modTab[7,modNo])
			TargetTab[4,currRow] := to_str(CategoryInfo,modTab[6,modNo]) -- transfer key words (if exists)
			--debug
		next -- modNo

	next -- object/Folder
next

--Fill the Keywords Tab 
if UserInterfaceLanguage=0 -- When User Interface is german, fill in german keywords
	KeyWords.copyRangeTo({2,1}..{2,*},TargetTab,4,1)
else -- otherwise fill in english keywords
	KeyWords.copyRangeTo({1,1}..{1,*},TargetTab,4,1)
end
2026-08-31 21:03:19: ###PE:.Models.internal.Admin.GeneralTable2ExampleTab###
2026-08-31 21:03:19: ###E:.Models.internal.Admin.GeneralTable2ExampleTab###

