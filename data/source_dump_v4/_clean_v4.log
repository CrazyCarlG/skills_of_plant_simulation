2026-08-31 21:03:24: T=Method
2026-08-31 21:03:24: N=CountOccur
2026-08-31 21:03:24: ###P:.Models.internal.Admin.CountOccur###
2026-08-31 21:03:24: -- called by: CalcScore
param word:string,str:string,tab:integer -> integer
-- tab: column of table 'ExampleTab'
-- word = searchStr, str = strToLower(searchStr)
var occurences:integer
var iterate:=true
var idx:integer
while iterate
	idx:=strLpos(str,word)
	if idx>0
		occurences+=1
		word:=strOmit(word,0,idx+strlen(str))
		var delimiter:=strAscii(strToUpper(strCopy(word,1,1)))
		if (delimiter>128 or (delimiter>=65 and delimiter<=90))
			occurences+=1
		else
			if tab=5 or tab=6 -- TitleDEU or TitleENU
				occurences += 10
			else
				occurences += 2
			end
		end
	else
		iterate:=false
	end
end

return occurences
2026-08-31 21:03:24: ###PE:.Models.internal.Admin.CountOccur###
2026-08-31 21:03:24: ###E:.Models.internal.Admin.CountOccur###

