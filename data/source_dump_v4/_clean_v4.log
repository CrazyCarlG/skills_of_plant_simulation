=========== .Models.internal.Admin.startSearch  [Method]  result=success ===========
2026-08-31 21:03:19: Log file opened! Application Version: 2606.0002, UTC: 2026-08-31 13:03:19
2026-08-31 21:03:19: execute sim-code: 'var o: object
o := s......'
2026-08-31 21:03:19: ###B:.Models.internal.Admin.startSearch###
2026-08-31 21:03:19: T=Method
2026-08-31 21:03:19: N=startSearch
2026-08-31 21:03:19: ###P:.Models.internal.Admin.startSearch###
2026-08-31 21:03:19: -- called by Search button
if ExampleTab.yDim = 0
	/*switch userInterfaceLanguage
	case 0
		infobox("Bitte warten Sie, bis die Ergebnisse der Suche angezeigt werden.",false)
	else
		infobox("Please wait until the results of your search are being shown.",false)
	end*/
	GeneralTable2ExampleTab
	--infobox("",false)
end
var t: table
t.create
t.setDataType(8,"Integer")
searchStr := ~.SelDlg.getValue("SearchString_inp") -- search strinf of the user
if searchStr = ""
	return
end

var a:string[]
ExampleTab.setCursor(2,1)
if ExampleTab.find({2,1}..{2,*},searchStr) -- search e.g. ".Models.Robot.StackedParts"; ".Models.worker.Manpower"
	a := splitString(searchStr,".") -- determine objName,frameName
	if ~.SelDlg.showExample(a[2],a[3]) -- set Drop-down list boxes of the dialog
		return
	end
end -- found e.g. ".Models.Robot.StackedParts"

var str:string := strToLower(searchStr)
var StrToBeSearched:string
var curr:integer
var found:boolean
var score:integer

for var row := 1 to ExampleTab.ydim
	score:=0
	for var col := 4 to 8 -- Col 1 is contained in col 2
	StrToBeSearched:=strToLower(to_str(ExampleTab[col,row]))
/*		if UserInterfaceLanguage=0 and (col=5 or col=7) -- When User Interface is german, skip english title and description
			continue
		elseif UserInterfaceLanguage/=0 and (col=6 or col=8) -- When User Interface is not german, skip german title and description
			continue
			end
*/			
		if strLpos(str,StrToBeSearched) > 0 -- str = search string of the user, StrToBeSearched depends on the column of ExampleTab
			if not found
				found := true 
				curr += 1 -- number of hits of the search
				--                 Deutscher Titel	  Englischer Titel   Beschreibung DEU   Beschreibung ENG   3D aktiv ja/nein			  Pfad zu Objekt	 Name des Netzwerks  Wertung
				t.writeRow(1,curr, ExampleTab[6,row], ExampleTab[5,row], ExampleTab[8,row], ExampleTab[7,row], to_str(ExampleTab[3,row]), ExampleTab[1,row], ExampleTab[2,row],  score)
			end
			score += calcScore(col,StrToBeSearched,str) -- (score > 0) if and only if the search string occurs
			t[8,curr] := score -- t = cummulated table of all hits (together with informations of the single example)
		end
	next -- col
	found:=false
	
next -- row of ExampleTab

if t.yDim > 0
	t.sort(8,"down")
	str := t[7,1]
	a := splitString(str,".") -- var a:string[]
	~.SelDlg.showExample(a[2],a[3]) 
end

displayResults(t)
2026-08-31 21:03:20: ###PE:.Models.internal.Admin.startSearch###
2026-08-31 21:03:20: ###E:.Models.internal.Admin.startSearch###

