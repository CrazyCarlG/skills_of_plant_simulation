2026-08-31 21:03:18: param str:string -> string
var charArray := makeArray("\"", "'")
var s:string
for var charNo := 1 to charArray.dim
	s := charArray[charNo]
	while strLpos(s,str) > 0
		str:= strOmit(str,strLpos(s,str),1)
	end
next
return str
