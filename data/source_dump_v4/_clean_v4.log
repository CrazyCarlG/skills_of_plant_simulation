2026-08-31 21:03:17: ###B:.Models.internal.Localization.getMessage###
2026-08-31 21:03:17: T=Method
2026-08-31 21:03:17: N=getMessage
2026-08-31 21:03:17: ###P:.Models.internal.Localization.getMessage###
2026-08-31 21:03:17: param MsgNumber : integer, p1,p2,p3 : any->string

var mess, s1, s2, s3	: string
var pos1, pos2, pos3	: integer

if messageTab.YDIm<MsgNumber 
	mess := getText( 1 )
	s1 := to_str( MsgNumber )
else
	mess := messageTab[ UserInterfaceLanguage+1, MsgNumber ]
	if mess = "" 
		mess := messageTab[ "ENU", MsgNumber ]
	end
end

s1 := to_str(p1)
s2 := to_str(p2)
s3 := to_str(p3)

pos1 := strLpos("$1", mess)
pos2 := strLpos("$2", mess)
pos3 := strLpos("$3", mess)

if pos3 > 0 
	mess := strIncl(s3, mess, pos3+2)
	mess := strOmit(mess, pos3, 2)
end
if pos2 > 0 
	mess := strIncl(s2, mess, pos2+2)
	mess := strOmit(mess, pos2, 2)
end
if pos1 > 0 
	mess := strIncl(s1, mess, pos1+2)
	mess := strOmit(mess, pos1, 2)
end
result := mess
