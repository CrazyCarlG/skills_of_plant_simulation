2026-08-31 20:57:13: -- called by: .Models.internal.Admin.dispatcher (The user clicked a ling to open a frame.)
param frame:string
ExamNo := 0;
ExampleTab.setCursor(2,1)
if ExampleTab.find({2,1}..{2,*}, frame)
	ExamNo := ExampleTab.cursorY
end
