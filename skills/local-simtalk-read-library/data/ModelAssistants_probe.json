var RS:string := strChr(2)
var ESC:string := strChr(3)
var out:string := \"\
var ch:string
var code:string
var i:integer := 1
while i <= strLen(value)
    ch := strCopy(value, i, 1)
    if ch = ESC and i < strLen(value)
        i += 1
        code := strCopy(value, i, 1)
        switch code
        case \"E\
            out := to_str(out, ESC)
        case \"F\
            out := to_str(out, FS)
        case \"R\
            out := to_str(out, RS)
        else
            out := to_str(out, code)
        end
    else
        out := to_str(out, ch)
    end
    i += 1
end
return out
