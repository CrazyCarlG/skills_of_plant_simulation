        out := to_str(out, RS, \"P\", FS, current.M_Encode(sourceRel), FS,
            current.M_Encode(attrName), FS, current.M_Encode(attrType), FS, \"1\", FS,
            current.M_Encode(value))
    end
next
for i := 1 to ctrls.Dim
    value := current.M_ReadAttribute(to_str(sourceFrame), ctrls[i])
    if value /= \"\" and value /= \"VOID\
