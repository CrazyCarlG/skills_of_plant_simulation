--| Function   : serialize one supported object and send a length-prefixed stream
--| Parameter  : -
--| Return     : boolean
--| Call       : M_BuildObject, M_BuildFrame
--| Date       : 2026.07.19
--| Programmer : ModelSyncCopy
------------------------------------------------------------
-> boolean
var src:object
var payload:string
var FS:string := strChr(1)
var len:integer
var cs:integer
var total:integer
var k:integer
var full:string
var flen:integer
if not existsObject(current.SourcePath)
    current.LastError := to_str(\"Source object not found: \", current.SourcePath)
    return false
end
if not current.SocketClient.On
    current.LastError := \"Client socket is not connected\
    return false
end
src := str_to_obj(current.SourcePath)
if src.InternalClassName = \"Network\
    payload := current.M_BuildFrame(src)
else
    payload := current.M_BuildObject(src)
end
if payload = \"\
    current.LastError := to_str(\"Unsupported source type: \", src.InternalClassName,
        \" (supports Frame, Method, DataTable, Variable, PythonModule)\")
    return false
end
current.LastPayload := payload
len := strLen(payload)
full := to_str(\"MSCL\", FS, len, FS, payload)
flen := strLen(full)
cs := current.ChunkSize
if cs < 256 then cs := 256 end
total := (flen + cs - 1) div cs
for k := 1 to total
    current.SocketClient.write(0, strCopy(full, (k - 1) * cs + 1, cs))
next
current.LastSummary := to_str(\"sentType=\", src.InternalClassName, \" name=\", src.Name,
    \" payloadChars=\", len, \" chunks=\", total)
current.LastError := to_str(\"Sent \", src.Name, \" in \", total, \" chunk(s) (\", len, \" chars)\")
return true
