\tvar s_candidate:string := current.Tab_Candidate[1,i]

\t-- candidate is void and skip
\tif o_candidate /= void and tab_tmproated.getrowNo(s_candidate) < 0

\t\t-- record old angle
\t\ttab_tmproated.appendRow(s_candidate, o_candidate._3D.Rotation[1], o_candidate._3D.Rotation[2], o_candidate._3D.Rotation[3], o_candidate._3D.Rotation[4])

\t\t-- rotate
\t\tif current.bol_AddedCurrent
\t\t\to_candidate._3D.Rotation := basis.~._3D.concatenateRotations(o_candidate._3D.Rotation, Rotation)
\t\telse
