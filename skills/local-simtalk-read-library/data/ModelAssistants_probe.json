case \"Method\
    return to_str(\"MSCO\", FS, \"v1\", FS, version, FS, \"M\", FS,
        current.M_Encode(src.Name), FS, to_str(p[1]), FS, to_str(p[2]), FS,
        to_str(p[3]), FS, current.M_Encode(src.Program))
case \"PythonModule\
    return to_str(\"MSCO\", FS, \"v1\", FS, version, FS, \"P\", FS,
        current.M_Encode(src.Name), FS, to_str(p[1]), FS, to_str(p[2]), FS,
        to_str(p[3]), FS, current.M_Encode(to_str(src.Class)), FS,
        current.M_Encode(src.PythonCode))
case \"NwData\
    return to_str(\"MSCO\", FS, \"v1\", FS, version, FS, \"V\", FS,
        current.M_Encode(src.Name), FS, to_str(p[1]), FS, to_str(p[2]), FS,
        to_str(p[3]), FS, current.M_Encode(src.DataType), FS,
        current.M_Encode(current.M_ReadVariableValue(src)))
case \"NwList2D\
    out := to_str(\"MSCO\", FS, \"v1\", FS, version, FS, \"T\", FS,
        current.M_Encode(src.Name), FS, to_str(p[1]), FS, to_str(p[2]), FS,
        to_str(p[3]), FS, current.M_Encode(src.DataType), FS,
        current.M_Encode(src.DataTypeColumnIndex), FS, to_str(src.RowIndex), FS,
        to_str(src.ColumnIndex), FS, to_str(src.MaxXDim), FS, to_str(src.XDim), FS,
        to_str(src.YDim), FS, current.M_Encode(src.getDataType(0)))
    for col := 1 to src.XDim
        tp := src.getDataType(col)
        out := to_str(out, RS, \"D\", FS, col, FS, current.M_Encode(tp))
    next
    if src.ColumnIndex
        for col := 1 to src.XDim
            out := to_str(out, RS, \"H\", FS, col, FS, current.M_Encode(to_str(src[col,0])))
        next
    end
    if src.RowIndex
        tp := src.getDataType(0)
        for row := 1 to src.YDim
            out := to_str(out, RS, \"R\", FS, row, FS, current.M_Encode(tp), FS,
                current.M_Encode(to_str(src[0,row])))
        next
    end
    for row := 1 to src.YDim
        for col := 1 to src.XDim
            tp := src.getDataType(col)
            out := to_str(out, RS, \"K\", FS, col, FS, row, FS,
                current.M_Encode(tp), FS, current.M_Encode(to_str(src[col,row])))
        next
    next
    return out
end
return \"\
