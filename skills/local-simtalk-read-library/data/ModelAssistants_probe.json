--| Function   : restore text escaped by M_Encode
--| Parameter  : value:string
--| Return     : string
--| Called     : M_ApplyObject
--| Date       : 2026.07.19
--| Programmer : ModelSyncCopy
------------------------------------------------------------
param value:string
