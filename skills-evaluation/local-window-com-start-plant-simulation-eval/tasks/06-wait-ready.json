{
  "category": "wait-ready",
  "description": "--wait-ready behavior — TCP poll, timeout, ConnectionRefusedError tolerance. All hermetic. We use a port we expect to be free (51111) and a port we expect free on the runner (1 is reserved and connection-refused on most systems).",
  "tasks": [
    {
      "id": "wait-001-default-skipped",
      "category": "wait-ready",
      "name": "no --wait-ready → poll is skipped, no 'Waiting for socket' on stderr",
      "args": [],
      "mock": true,
      "timeout": 10,
      "weight": 1.5,
      "expected": {
        "exit_code": 0,
        "stderr_excludes": ["Waiting for socket"],
        "stdout_includes": ["Plant Simulation launched"],
        "wall_time_max_ms": 350
      },
      "tags": ["hermetic", "lifecycle", "cli-args-§wait-ready", "regression"]
    },
    {
      "id": "wait-002-wait-ready-1-busy-port",
      "category": "wait-ready",
      "name": "--wait-ready 1 with assumed-busy port 51111 → exit 3 + TimeoutError",
      "args": ["-p", "51111", "--wait-ready", "1"],
      "mock": true,
      "timeout": 15,
      "weight": 2.0,
      "expected": {
        "exit_code": 3,
        "stderr_includes": ["socket readiness check failed", "51111"],
        "stdout_excludes": ["Plant Simulation launched"],
        "wall_time_max_ms": 2700
      },
      "tags": ["hermetic", "exit-3", "cli-args-§wait-ready", "lifeline-L5", "regression"],
      "notes": "If port 51111 happens to be in use on the test host, this task will spuriously succeed. The runner should be run on a host with that port free, or the test host should set a different port via task config."
    },
    {
      "id": "wait-003-wait-ready-0-explicit",
      "category": "wait-ready",
      "name": "--wait-ready 0 (explicit) → poll is skipped, exit 0",
      "args": ["--wait-ready", "0"],
      "mock": true,
      "timeout": 10,
      "weight": 1.0,
      "expected": {
        "exit_code": 0,
        "stderr_excludes": ["Waiting for socket"],
        "wall_time_max_ms": 350
      },
      "tags": ["hermetic", "lifecycle", "cli-args-§wait-ready", "regression"]
    },
    {
      "id": "wait-004-wait-ready-negative-skipped",
      "category": "wait-ready",
      "name": "--wait-ready -1 → script treats as 'skip' (only > 0 triggers poll), exit 0",
      "args": ["--wait-ready", "-1"],
      "mock": true,
      "timeout": 10,
      "weight": 1.5,
      "expected": {
        "exit_code": 0,
        "stderr_excludes": ["Waiting for socket"],
        "wall_time_max_ms": 350
      },
      "tags": ["hermetic", "edge-case", "cli-args-§wait-ready", "regression"]
    },
    {
      "id": "wait-005-progress-on-stderr",
      "category": "wait-ready",
      "name": "--wait-ready poll → 'Waiting for socket' progress on stderr (not stdout)",
      "args": ["-p", "51112", "--wait-ready", "2"],
      "mock": true,
      "timeout": 15,
      "weight": 1.5,
      "expected": {
        "exit_code": 3,
        "stderr_includes": ["Waiting for socket on 127.0.0.1:51112"],
        "stdout_excludes": ["Waiting for socket"],
        "wall_time_max_ms": 5000
      },
      "tags": ["hermetic", "stdout-stderr-discipline", "cli-args-§output", "regression"]
    }
  ]
}
