{
  "category": "model-load",
  "description": "Model loading behavior — verifies LoadModel + SetTrustModels are called in order, abspath is applied, and the file-not-found path exits 4 with the absolute path in the error message.",
  "tasks": [
    {
      "id": "model-001-loadmodel-called",
      "category": "model-load",
      "name": "happy path — LoadModel is called on the COM object",
      "args": ["-p", "50007"],
      "mock": true,
      "timeout": 10,
      "weight": 2.0,
      "expected": {
        "exit_code": 0,
        "mock_call_sequence_includes": [
          "Dispatch('Tecnomatix.PlantSimulation.RemoteControl.26.6')",
          "Tecnomatix.PlantSimulation.RemoteControl.26.6.LoadModel"
        ],
        "stdout_includes": ["Plant Simulation launched, model loaded, socket port set to 50007"],
        "wall_time_max_ms": 350
      },
      "tags": ["hermetic", "smoke", "lifecycle", "regression"]
    },
    {
      "id": "model-002-settrustmodels-called",
      "category": "model-load",
      "name": "SetTrustModels is called after LoadModel",
      "args": ["-p", "50007"],
      "mock": true,
      "timeout": 10,
      "weight": 1.5,
      "expected": {
        "exit_code": 0,
        "mock_call_sequence_includes": [
          "Tecnomatix.PlantSimulation.RemoteControl.26.6.SetTrustModels"
        ],
        "wall_time_max_ms": 350
      },
      "tags": ["hermetic", "lifecycle", "regression"]
    },
    {
      "id": "model-003-setvisible-called",
      "category": "model-load",
      "name": "SetVisible is called (default visible=True)",
      "args": ["-p", "50007"],
      "mock": true,
      "timeout": 10,
      "weight": 1.0,
      "expected": {
        "exit_code": 0,
        "mock_call_sequence_includes": [
          "Tecnomatix.PlantSimulation.RemoteControl.26.6.SetVisible"
        ],
        "wall_time_max_ms": 350
      },
      "tags": ["hermetic", "lifecycle", "regression"]
    },
    {
      "id": "model-004-abspath-applied",
      "category": "model-load",
      "name": "relative model path → error message uses the abspath form",
      "args": ["-m", "this_file_definitely_does_not_exist_relative.spp"],
      "mock": true,
      "timeout": 5,
      "weight": 2.0,
      "expected": {
        "exit_code": 4,
        "stderr_includes": ["Model file not found"],
        "stdout_empty": true,
        "wall_time_max_ms": 350
      },
      "tags": ["hermetic", "exit-4", "lifeline-L4", "cli-args-§abspath", "regression"]
    },
    {
      "id": "model-005-happy-integration",
      "category": "model-load",
      "name": "happy path — real PS loads real .spp (integration, requires PS)",
      "args": [],
      "mock": false,
      "timeout": 60,
      "weight": 0.0,
      "expected": {
        "exit_code": 0,
        "stdout_includes": ["Plant Simulation launched, model loaded, socket port set to"],
        "wall_time_max_ms": 30000
      },
      "tags": ["integration", "smoke", "skip-in-mock"],
      "notes": "Marked weight=0 so it does not affect the weighted pass rate. Excluded from --mock runs. CI must set default_model + default_simtalkclaudefile in .eval-config.yaml to real files."
    }
  ]
}
