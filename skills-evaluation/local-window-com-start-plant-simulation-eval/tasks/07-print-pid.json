{
  "category": "print-pid",
  "description": "--print-pid behavior — tasklist parsing, PID list on stdout, warning to stderr when not found.",
  "tasks": [
    {
      "id": "pid-001-flag-printed",
      "category": "print-pid",
      "name": "--print-pid + PS in tasklist → 'Plant Simulation PID: [...]' on stdout",
      "args": ["--print-pid"],
      "mock": true,
      "timeout": 10,
      "weight": 1.5,
      "expected": {
        "exit_code": 0,
        "stdout_includes": ["Plant Simulation launched"],
        "stdout_excludes": ["Plant Simulation PID:"],
        "wall_time_max_ms": 1000
      },
      "tags": ["hermetic", "lifecycle", "cli-args-§print-pid", "regression"],
      "notes": "In mock mode, the tasklist call will not find 'Plant Simulation.exe' (the test runner is python, not PS), so the script prints a warning to stderr and does NOT include 'Plant Simulation PID:' on stdout. This task verifies that the absence is correctly handled."
    },
    {
      "id": "pid-002-warning-when-no-ps",
      "category": "print-pid",
      "name": "--print-pid + no PS in tasklist → warning on stderr, exit 0",
      "args": ["--print-pid"],
      "mock": true,
      "timeout": 10,
      "weight": 2.0,
      "expected": {
        "exit_code": 0,
        "stderr_includes": ["--print-pid requested", "Plant Simulation.exe not found"],
        "wall_time_max_ms": 1000
      },
      "tags": ["hermetic", "lifecycle", "cli-args-§print-pid", "regression"]
    },
    {
      "id": "pid-003-not-requested",
      "category": "print-pid",
      "name": "no --print-pid → no PID line on stdout or stderr",
      "args": [],
      "mock": true,
      "timeout": 10,
      "weight": 1.0,
      "expected": {
        "exit_code": 0,
        "stdout_excludes": ["Plant Simulation PID:"],
        "stderr_excludes": ["Plant Simulation PID:"],
        "stderr_excludes": ["--print-pid"],
        "wall_time_max_ms": 1000
      },
      "tags": ["hermetic", "lifecycle", "cli-args-§print-pid", "regression"]
    }
  ]
}
