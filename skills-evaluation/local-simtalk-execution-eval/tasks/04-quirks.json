{
  "category": "quirks",
  "description": "Quirk #5/#6/#7/#13 + Q-001/Q-002 protocol edge cases. ALL tasks in this file are weighted 3× — a regression here is non-negotiable (per CI gate).",
  "tasks": [
    {
      "id": "quirk-005-retsult-stale",
      "category": "quirks",
      "name": "Quirk #5 — retsult field is always stale; runner must pass on result (not retsult)",
      "type": "simtalk_syntax",
      "code": "var x: integer := 1",
      "timeout": 10,
      "tags": ["quirk-5", "regression"],
      "weight": 3.0,
      "expected": {
        "exit_code": 0,
        "result_includes": ["has no Error"],
        "result_excludes": ["hasError"],
        "wall_time_max_ms": 3000
      }
    },
    {
      "id": "quirk-006-data-field-ignored",
      "category": "quirks",
      "name": "Quirk #6 — data field is always absent on simtalk_run; return_value:true is a no-op",
      "type": "simtalk_run",
      "code": "-> integer\nreturn 42",
      "timeout": 15,
      "tags": ["quirk-6", "regression"],
      "weight": 3.0,
      "expected": {
        "exit_code": 0,
        "result_includes": ["success"],
        "log_not_starts_with": "code execute failed",
        "wall_time_max_ms": 8000
      }
    },
    {
      "id": "quirk-007-soft-failure-detected",
      "category": "quirks",
      "name": "Quirk #7 — runtime exception returns exit 11, not exit 0",
      "type": "simtalk_run",
      "code": "print undeclared_identifier_here",
      "timeout": 15,
      "tags": ["quirk-7", "regression", "lifelines-§6"],
      "weight": 3.0,
      "expected": {
        "exit_code": 11,
        "log_starts_with": "code execute failed",
        "wall_time_max_ms": 8000
      }
    },
    {
      "id": "quirk-013-unknown-type-hangs",
      "category": "quirks",
      "name": "Quirk #13 — unknown type value → silent hang → runner must TIMEOUT (not exit 0)",
      "type": "simtalk_run",
      "code": "",
      "timeout": 5,
      "mode": "raw_socket",
      "raw_data": "{\"type\":\"fake_nonexistent_type\",\"action_id\":\"quirk13\",\"timestamp\":\"abc\"}||END||",
      "tags": ["quirk-13", "regression", "lifelines-§3"],
      "weight": 3.0,
      "expected": {
        "exit_code": 1,
        "wall_time_max_ms": 6000
      }
    },
    {
      "id": "quirk-readlog-q002-stdout-valid",
      "category": "quirks",
      "name": "Q-002 — readlog exit 20 still has valid stdout (don't discard it)",
      "type": "readlog",
      "timeout": 10,
      "tags": ["quirk-readlog", "Q-002", "lifelines-§5"],
      "weight": 3.0,
      "expected": {
        "exit_code_in": [0, 20],
        "wall_time_max_ms": 5000
      }
    }
  ]
}