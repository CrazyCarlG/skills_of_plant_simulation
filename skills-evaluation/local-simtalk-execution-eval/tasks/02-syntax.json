{
  "category": "syntax",
  "description": "simtalk_syntax success/failure cases — all verified against example.md and v10 param cheat sheet.",
  "tasks": [
    {
      "id": "syntax-001-valid-var",
      "category": "syntax",
      "name": "valid var declaration with init",
      "type": "simtalk_syntax",
      "code": "var x: integer := 42",
      "timeout": 10,
      "tags": ["smoke", "happy-path"],
      "expected": {
        "exit_code": 0,
        "result_includes": ["has no Error"],
        "result_excludes": ["hasError"],
        "wall_time_max_ms": 3000
      }
    },
    {
      "id": "syntax-002-valid-control-flow",
      "category": "syntax",
      "name": "valid while loop with multi-line body",
      "type": "simtalk_syntax",
      "code": "var n: integer := 3\nwhile n > 0\n  print n\n  n -= 1\nend",
      "timeout": 10,
      "tags": ["happy-path", "control-flow"],
      "expected": {
        "exit_code": 0,
        "result_includes": ["has no Error"],
        "result_excludes": ["hasError"],
        "wall_time_max_ms": 3000
      }
    },
    {
      "id": "syntax-003-valid-param-default",
      "category": "syntax",
      "name": "valid param with default value (v10 safest form)",
      "type": "simtalk_syntax",
      "code": "param str:string := \"x\"\nprint str",
      "timeout": 10,
      "tags": ["happy-path", "param", "v10"],
      "expected": {
        "exit_code": 0,
        "result_includes": ["has no Error"],
        "result_excludes": ["hasError"],
        "wall_time_max_ms": 3000
      }
    },
    {
      "id": "syntax-004-invalid-byval",
      "category": "syntax",
      "name": "param byval — explicit byval is illegal (byval is default)",
      "type": "simtalk_syntax",
      "code": "param byval str:string\nprint str",
      "timeout": 10,
      "tags": ["negative", "param", "v10"],
      "expected": {
        "exit_code": 12,
        "result_excludes": ["has no Error"],
        "result_includes": ["hasError"],
        "wall_time_max_ms": 3000
      }
    },
    {
      "id": "syntax-005-invalid-byref-default",
      "category": "syntax",
      "name": "param byref with default value — language forbids",
      "type": "simtalk_syntax",
      "code": "param byref str:string := \"x\"\nprint str",
      "timeout": 10,
      "tags": ["negative", "param", "v10"],
      "expected": {
        "exit_code": 12,
        "result_includes": ["hasError"],
        "result_excludes": ["has no Error"],
        "wall_time_max_ms": 3000
      }
    },
    {
      "id": "syntax-006-invalid-name-clash",
      "category": "syntax",
      "name": "var + param name-clash pattern (v9 regression case)",
      "type": "simtalk_syntax",
      "code": "var a,b: integer\nparam x: real := 1.0\nreturn x+a",
      "timeout": 10,
      "tags": ["negative", "v9-regression"],
      "expected": {
        "exit_code": 12,
        "result_includes": ["hasError"],
        "result_excludes": ["has no Error"],
        "wall_time_max_ms": 3000
      }
    }
  ]
}