{
  "category": "run",
  "description": "simtalk_run — happy paths + compile/runtime error boundaries (Quirk #7 vs compile-time vs Q-001).",
  "tasks": [
    {
      "id": "run-001-print-string",
      "category": "run",
      "name": "run print() of a string literal",
      "type": "simtalk_run",
      "code": "print(\"hello from SimTalk\")",
      "timeout": 15,
      "tags": ["happy-path"],
      "expected": {
        "exit_code": 0,
        "result_includes": ["success"],
        "log_not_starts_with": "code execute failed",
        "json_field": {"result": "success"},
        "wall_time_max_ms": 8000
      }
    },
    {
      "id": "run-002-arithmetic",
      "category": "run",
      "name": "run arithmetic expression",
      "type": "simtalk_run",
      "code": "print 1+1",
      "timeout": 15,
      "tags": ["happy-path"],
      "expected": {
        "exit_code": 0,
        "result_includes": ["success"],
        "log_not_starts_with": "code execute failed",
        "json_field": {"result": "success"},
        "wall_time_max_ms": 8000
      }
    },
    {
      "id": "run-003-quirk7-runtime-unknown-identifier",
      "category": "run",
      "name": "Quirk #7 — unknown identifier triggers soft fail (exit 11)",
      "type": "simtalk_run",
      "code": "print nonExistentVariable",
      "timeout": 15,
      "tags": ["quirk-7", "runtime-error", "lifelines-§6"],
      "weight": 2.0,
      "expected": {
        "exit_code": 11,
        "log_starts_with": "code execute failed",
        "result_includes": ["success"],
        "wall_time_max_ms": 8000
      }
    },
    {
      "id": "run-004-compile-error-division-by-zero",
      "category": "run",
      "name": "Q-001 — literal 1/0 is compile-time, NOT Quirk #7 (exit 10)",
      "type": "simtalk_run",
      "code": "print 1/0",
      "timeout": 15,
      "tags": ["compile-error", "Q-001", "lifelines-§6"],
      "weight": 2.0,
      "expected": {
        "exit_code": 10,
        "result_includes": ["failed"],
        "log_starts_with": " hasError",
        "wall_time_max_ms": 8000
      }
    },
    {
      "id": "run-005-return-with-type",
      "category": "run",
      "name": "valid -> T + return (v8 fixed form)",
      "type": "simtalk_run",
      "code": "-> integer\nreturn 42",
      "timeout": 15,
      "tags": ["happy-path", "v8"],
      "expected": {
        "exit_code": 0,
        "result_includes": ["success"],
        "log_not_starts_with": "code execute failed",
        "wall_time_max_ms": 8000
      }
    },
    {
      "id": "run-006-list-dim",
      "category": "run",
      "name": "list.dim is the only correct length query (lifelines §10.1)",
      "type": "simtalk_run",
      "code": "var l: list\nl := getFilesOfFolder(\".\")\nprint l.dim",
      "timeout": 15,
      "tags": ["happy-path", "list-api", "lifelines-§10"],
      "expected": {
        "exit_code": 0,
        "result_includes": ["success"],
        "log_not_starts_with": "code execute failed",
        "wall_time_max_ms": 10000
      }
    }
  ]
}